<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\ExemploGRPC.Application\ExemploGRPC.Application.csproj" />
    <ProjectReference Include="..\ExemploGRPC.Infrastructure\ExemploGRPC.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AutoMapper.Extensions.Microsoft.DependencyInjection" Version="12.0.1" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.66.0" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\cliente.proto" GrpcServices="Server" />
    <Protobuf Include="Protos\cargo.proto" GrpcServices="Server" />
